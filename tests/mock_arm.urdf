<?xml version="1.0"?>
<!-- MOCK 6-DOF arm (reach ~0.6 m) used ONLY to unit-test the code. NOT the CR3A. -->
<robot name="mock">
  <link name="base_link"/><link name="l1"/><link name="l2"/><link name="l3"/><link name="l4"/><link name="l5"/><link name="l6"/><link name="flange"/>
  <joint name="j1" type="revolute"><parent link="base_link"/><child link="l1"/><origin xyz="0 0 0.14"/><axis xyz="0 0 1"/><limit lower="-6.0" upper="6.0" velocity="3.14" effort="50"/></joint>
  <joint name="j2" type="revolute"><parent link="l1"/><child link="l2"/><origin xyz="0 0 0"/><axis xyz="0 1 0"/><limit lower="-2.9" upper="2.9" velocity="3.14" effort="50"/></joint>
  <joint name="j3" type="revolute"><parent link="l2"/><child link="l3"/><origin xyz="0 0 0.28"/><axis xyz="0 1 0"/><limit lower="-2.7" upper="2.7" velocity="3.14" effort="50"/></joint>
  <joint name="j4" type="revolute"><parent link="l3"/><child link="l4"/><origin xyz="0 0 0.25"/><axis xyz="0 1 0"/><limit lower="-3.0" upper="3.0" velocity="3.14" effort="20"/></joint>
  <joint name="j5" type="revolute"><parent link="l4"/><child link="l5"/><origin xyz="0 0 0.06"/><axis xyz="0 0 1"/><limit lower="-6.0" upper="6.0" velocity="3.14" effort="20"/></joint>
  <joint name="j6" type="revolute"><parent link="l5"/><child link="l6"/><origin xyz="0 0 0.05"/><axis xyz="0 1 0"/><limit lower="-3.0" upper="3.0" velocity="3.14" effort="20"/></joint>
  <joint name="jf" type="fixed"><parent link="l6"/><child link="flange"/><origin xyz="0 0 0.06"/></joint>
</robot>
